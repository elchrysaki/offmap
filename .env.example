# Public app configuration
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SITE_URL=http://localhost:8081

# CMS and database
DATABASE_URL=postgres://offmap:offmap@localhost:5433/offmap
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
OFFMAP_ADMIN_EMAIL=admin@example.com
OFFMAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
SUBMISSION_HASH_SECRET=replace-with-a-separate-random-secret

# Optional, admin-invoked research only
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_RESEARCH_PROMPT_VERSION=offmap-research-v1

# Student accounts (optional sign-in, ADR 0005)
# Keep false until docs/legal/ is confirmed reviewed and live (AGENTS.md).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
