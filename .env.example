# Supabase (database, auth, storage) — one source of truth, CLAUDE.md §10
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini AI verification — admin "Verify with AI" and the weekly
# check-application-links Edge Function (CLAUDE.md §3/§6)
GEMINI_API_KEY=

# Resend — deadline alert emails, EU region (CLAUDE.md §3)
RESEND_API_KEY=

# Student accounts, optional OAuth providers (ADR 0005)
# Google stays false until its Cloud Console + Supabase provider config is done.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
